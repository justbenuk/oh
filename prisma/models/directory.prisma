model Licensing {
  id            String  @id @default(cuid())
  name          String
  websiteUrl    String?
  logo          String?
  email         String?
  contactNumber String?

  media Media[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("licensing")
}

model DirectoryCategory {
  id          String @id @default(cuid())
  name        String
  description String
  image       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("directory-category")
}
